{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LogisticsSystem": ""
  },
  "Jwt": {
    "Issuer": "LogisticsSystem",
    "Audience": "LogisticsSystemUsers",
    "SecretKey": "",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Email": {
    "Provider": "Smtp",
    "SenderEmail": "",
    "SenderName": "Logistics System",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "EnableSsl": true,
    "MaxRetries": 3,
    "ConfirmationUrl": "",
    "ResetPasswordUrl": ""
  },
  "Dispatch": {
    "AssignmentExpirationMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "https://app.logistics.com",
      "https://admin.logistics.com"
    ]
  }
}
