# ==============================================================================
# LogisticsSystem - Production Environment Variables Example
# Copy this file to .env or configure these variables in your deployment platform
# (e.g., Azure App Service, Kubernetes Secrets, Docker Compose, AWS ECS)
# ==============================================================================

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Database Configuration (SQL Server)
# Format: Server=<server>,<port>;Database=<dbname>;User Id=<username>;Password=<password>;TrustServerCertificate=False;Encrypt=True;
ConnectionStrings__LogisticsSystem=Server=sqlserver,1433;Database=LogisticsSystem_Prod;User Id=sa;Password=YourStrongProductionPassword123!;TrustServerCertificate=False;Encrypt=True;MultipleActiveResultSets=true;

# JWT Authentication Configuration
Jwt__Issuer=LogisticsSystem
Jwt__Audience=LogisticsSystemUsers
# Secret key must be a cryptographically strong string of at least 256 bits (32+ characters)
Jwt__SecretKey=REPLACE_WITH_SECURE_MIN_32_CHAR_PRODUCTION_SECRET_KEY_1234567890!
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=7

# Email & Frontend URLs
Email__ConfirmationUrl=https://app.logistics.com/confirm-email
Email__ResetPasswordUrl=https://app.logistics.com/reset-password

# Background Dispatch Configuration
Dispatch__AssignmentExpirationMinutes=5
